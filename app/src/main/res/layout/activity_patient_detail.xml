<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Name"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Goal: --"
                android:textColor="#6C757D"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Chart Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight Progress"
                    android:textColor="#2A9D8F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.example.healthieru.ui.ProgressChartView
                    android:id="@+id/chartWeight"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvTrend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No trend data yet."
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Summary will appear here."
                    android:textColor="#2B2D42"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Prescribe Action Plan"
                android:textColor="#1A1A1A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Category Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiet"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diet Plan" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWorkout"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workout" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdvice"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General Advice" />
            </com.google.android.material.chip.ChipGroup>

            <!-- DYNAMIC INPUT AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- 1. GENERAL ADVICE INPUT -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutGeneralInput"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Write general advice here..."
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etGeneralAdvice"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:padding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. DIET PLAN INPUT -->
                <LinearLayout
                    android:id="@+id/layoutDietInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meal Schedule" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <TextView android:text="Meal" android:layout_columnWeight="1" android:textStyle="bold" android:padding="8dp"/>
                        <TextView android:text="Details" android:layout_columnWeight="2" android:textStyle="bold" android:padding="8dp"/>

                        <TextView android:text="Breakfast" android:padding="8dp"/>
                        <EditText android:id="@+id/etBreakfast" android:hint="e.g. Oats &amp; fruit" android:layout_columnWeight="2" android:background="@null" android:padding="8dp"/>

                        <TextView android:text="Lunch" android:padding="8dp"/>
                        <EditText android:id="@+id/etLunch" android:hint="e.g. Grilled chicken salad" android:layout_columnWeight="2" android:background="@null" android:padding="8dp"/>

                        <TextView android:text="Dinner" android:padding="8dp"/>
                        <EditText android:id="@+id/etDinner" android:hint="e.g. Steamed fish &amp; veggies" android:layout_columnWeight="2" android:background="@null" android:padding="8dp"/>
                    </GridLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Recipe Video Link (YouTube, etc.)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDietLink"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 3. WORKOUT PLAN INPUT -->
                <LinearLayout
                    android:id="@+id/layoutWorkoutInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Exercise Schedule" android:textStyle="bold" android:layout_marginBottom="8dp"/>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3">

                        <TextView android:text="Exercise" android:layout_columnWeight="2" android:textStyle="bold" android:padding="8dp"/>
                        <TextView android:text="Sets" android:layout_columnWeight="1" android:textStyle="bold" android:padding="8dp"/>
                        <TextView android:text="Reps" android:layout_columnWeight="1" android:textStyle="bold" android:padding="8dp"/>

                        <EditText android:id="@+id/etEx1" android:hint="e.g. Pushups" android:layout_columnWeight="2" android:background="@null" android:padding="8dp"/>
                        <EditText android:id="@+id/etSets1" android:inputType="number" android:hint="3" android:layout_columnWeight="1" android:background="@null" android:padding="8dp"/>
                        <EditText android:id="@+id/etReps1" android:hint="12" android:layout_columnWeight="1" android:background="@null" android:padding="8dp"/>

                        <EditText android:id="@+id/etEx2" android:hint="e.g. Squats" android:layout_columnWeight="2" android:background="@null" android:padding="8dp"/>
                        <EditText android:id="@+id/etSets2" android:inputType="number" android:hint="3" android:layout_columnWeight="1" android:background="@null" android:padding="8dp"/>
                        <EditText android:id="@+id/etReps2" android:hint="15" android:layout_columnWeight="1" android:background="@null" android:padding="8dp"/>
                    </GridLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Workout Video Link (YouTube, etc.)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWorkoutLink"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Follow-up Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Set Follow-up Status"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStable"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stable" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFollowUp"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Needs Follow-up" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUrgent"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgent Review" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Error Message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#EF233C"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendToPatient"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#2A9D8F"
                android:text="Send to Patient"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- HISTORY SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Previous Advice Sent"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No advice sent yet."
                android:textColor="#888888"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/notesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>