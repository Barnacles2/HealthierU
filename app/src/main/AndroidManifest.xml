<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--added-->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:name=".HealthierUApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthierU">

        <!-- Your original screen, kept but no longer the launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- New launcher screen -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RegisterActivity" android:label="Create account" />
        <activity android:name=".ui.DashboardActivity" android:label="Home" />
        <activity android:name=".ui.RecordDataActivity" android:label="Record health data" />
        <activity android:name=".ui.ReportActivity" android:label="Health report" />
        <activity android:name=".ui.RecommendationsActivity" android:label="Recommendations" />
        <activity android:name=".ui.ProfessionalActivity" android:label="Patients" />
        <activity android:name=".ui.PatientDetailActivity" android:label="Patient" />
        <activity android:name=".ui.ProgressActivity" android:label="My progress" />
    </application>

</manifest>